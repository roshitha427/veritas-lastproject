# Copy to backend/.env for local setup. Never commit the filled file.
APP_ENV=development
SECRET_KEY=
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=veritas
MYSQL_USER=veritas
MYSQL_PASSWORD=
# Optional alternative: mysql+pymysql://USER:URL_ENCODED_PASSWORD@HOST:3306/veritas
# DATABASE_URL=
# For a remote TLS MySQL server, use the provider's trusted CA file path.
# Hostname and certificate validation remain enabled.
MYSQL_SSL_CA=
MYSQL_POOL_SIZE=5
DATA_DIR=data
HOST=127.0.0.1
PORT=5000
WAITRESS_THREADS=6
ANALYSIS_WORKERS=1
ANALYSIS_QUEUE_SIZE=3
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Imported inference artifacts use these canonical paths.
TEXT_MODEL_PATH=models/text
IMAGE_MODEL_PATH=models/image-v2/model.joblib
AI_TEXT_MODEL_PATH=models/ai-text/model.joblib
AI_IMAGE_MODEL_PATH=models/ai-image
TEMPORAL_MODEL_PATH=models/video-temporal/model.joblib
EVIDENCE_NLI_MODEL_PATH=models/evidence-nli
WHISPER_MODEL=models/whisper-tiny
# A separate, qualified synthetic-video model is optional.
VIDEO_MODEL_PATH=
MODEL_TARGET_ACCURACY=.90

# public needs no API key. Optional Tavily and Gemini keys stay on the backend.
EVIDENCE_PROVIDER=public
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDED_SEARCH=false

# Optional email recovery. Empty mail settings disable email delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=12
PASSWORD_RESET_TTL_SECONDS=3600
